# Copy to .env. Every process reads these from the environment.
DATABASE_URL=postgres://jobs:jobs@localhost:55432/jobs?sslmode=disable

# API
PORT=8080
# Leave empty for open demo mode. When set, POST endpoints need X-API-Key.
API_KEY=
WORKER_STALE_SECONDS=10

# Worker
WORKER_ID=worker-local
WORKER_CONCURRENCY=2
POLL_INTERVAL_MS=500
# Spec defaults are 60/20. The handler timeout must be shorter than the lease.
LEASE_SECONDS=60
HANDLER_TIMEOUT_SECONDS=20
HEARTBEAT_SECONDS=2
REAP_INTERVAL_SECONDS=5
SHUTDOWN_GRACE_SECONDS=10
MAX_SLEEP_MS=10000

# Integration tests (separate database; created automatically if missing)
TEST_DATABASE_URL=postgres://jobs:jobs@localhost:55432/jobs_test?sslmode=disable
